# ==============================================================================
# IELTS Word Trainer — Supabase Environment Configuration
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. Go to: Project Settings -> API
# 3. Copy "Project URL" and "anon / public" API Key below.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Service Role Secret Key (used only in server/seed scripts, NEVER exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
